{
  "name": "PortainerAgent",
  "repo": "portainer/agent:lts",
  "registry": "https://hub.docker.com/r/portainer/agent",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/portainer/portainer/develop/app/assets/ico/apple-touch-icon.png",
  "category": [
    "Tools"
  ],
  "project": "https://www.portainer.io/",
  "support": "https://github.com/portainer/agent",
  "description": "Portainer Agent lets a separate Portainer server manage the Docker environment of this machine (containers, stacks, volumes, images). Add it in Portainer as a Docker Standalone environment via Agent on port 9001.",
  "donate": null,
  "requires": null,
  "paths": [
    {
      "name": "Docker Socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "description": "Docker API",
      "required": true
    },
    {
      "name": "Docker Volumes",
      "host": "/var/lib/docker/volumes",
      "container": "/var/lib/docker/volumes",
      "description": "Volume browsing",
      "required": true
    },
    {
      "name": "Host Root",
      "host": "/",
      "container": "/host",
      "description": "Host filesystem browsing",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Agent Port",
      "host": "9001",
      "container": "9001",
      "protocol": "tcp",
      "description": "Portainer server connects here",
      "required": true,
      "mask": false,
      "display": "always",
      "default": "9001"
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
}
