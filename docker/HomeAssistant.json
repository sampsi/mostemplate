{
  "name": "HomeAssistant",
  "repo": "ghcr.io/home-assistant/home-assistant:stable",
  "registry": "https://github.com/home-assistant/core/pkgs/container/home-assistant",
  "network": "host",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": true,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8123]",
  "icon": "https://raw.githubusercontent.com/sampsi/mostemplate/refs/heads/main/images/homeassistant.png",
  "category": [
    "Smart Home"
  ],
  "project": "https://www.home-assistant.io/",
  "support": "https://github.com/home-assistant",
  "description": "Open source home automation that puts local control and privacy first. Runs in host network mode (needed for device discovery) on port 8123.",
  "donate": null,
  "requires": null,
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/homeassistant",
      "container": "/config",
      "description": "Home Assistant configuration",
      "required": true
    },
    {
      "name": "D-Bus",
      "host": "/run/dbus",
      "container": "/run/dbus",
      "description": "Bluetooth via host D-Bus",
      "required": true,
      "mode": "ro"
    }
  ],
  "ports": [],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
}
