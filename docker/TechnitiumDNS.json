{
  "name": "TechnitiumDNS",
  "repo": "technitium/dns-server:latest",
  "registry": "https://hub.docker.com/r/technitium/dns-server",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --hostname=technitium --sysctl \"net.ipv4.ip_local_port_range=1024 65000\"",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:5380]",
  "icon": "https://raw.githubusercontent.com/TechnitiumSoftware/DnsServer/master/DnsServerCore/www/img/logo.png",
  "category": [
    "Network"
  ],
  "project": "https://technitium.com/dns/",
  "support": "https://github.com/TechnitiumSoftware/DnsServer",
  "description": "Technitium DNS Server: self-hosted authoritative and recursive DNS server with ad blocking, caching, DNS-over-HTTPS/TLS/QUIC and a web console on port 5380 (default login admin/admin, change it). If port 53 is already used on another address (e.g. libvirt dnsmasq), set the DNS host ports to LANIP:53, e.g. 192.168.1.10:53. In a cluster every node needs its own DNS_SERVER_DOMAIN.",
  "donate": null,
  "requires": null,
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/technitium",
      "container": "/etc/dns",
      "description": "Configuration, zones, blocklists",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "5380",
      "container": "5380",
      "protocol": "tcp",
      "description": "Web console (HTTP)",
      "required": true,
      "mask": false,
      "display": "always",
      "default": "5380"
    },
    {
      "name": "HTTPS / Cluster",
      "host": "53443",
      "container": "53443",
      "protocol": "tcp",
      "description": "Web console HTTPS and traffic between cluster nodes",
      "required": true,
      "mask": false,
      "display": "always",
      "default": "53443"
    },
    {
      "name": "DNS (UDP)",
      "host": "192.168.1.10:53",
      "container": "53",
      "protocol": "udp",
      "description": "DNS. LANIP:53 binds only that address; 53 = all addresses",
      "required": true,
      "mask": false,
      "display": "always",
      "default": "192.168.1.10:53"
    },
    {
      "name": "DNS (TCP)",
      "host": "192.168.1.10:53",
      "container": "53",
      "protocol": "tcp",
      "description": "DNS over TCP, same address as UDP",
      "required": true,
      "mask": false,
      "display": "always",
      "default": "192.168.1.10:53"
    }
  ],
  "variables": [
    {
      "name": "DNS_SERVER_DOMAIN",
      "key": "DNS_SERVER_DOMAIN",
      "value": "nucserver",
      "description": "DNS server name; must be unique on every cluster node",
      "required": true,
      "mask": false,
      "display": "always",
      "default": "nucserver"
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
