{
  "name": "NodeRED",
  "repo": "nodered/node-red:latest",
  "registry": "https://hub.docker.com/r/nodered/node-red",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --user=0:0",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:1880]",
  "icon": "https://raw.githubusercontent.com/sampsi/mostemplate/refs/heads/main/images/nodered.png",
  "category": [
    "Smart Home"
  ],
  "project": "https://nodered.org/",
  "support": "https://discourse.nodered.org/",
  "description": "Node-RED: low-code, browser-based flow programming for wiring together devices, APIs and online services (MQTT, HTTP, Home Assistant and thousands of community nodes). Editor on port 1880. No login by default: enable adminAuth in settings.js (in the appdata folder) if exposed.",
  "donate": null,
  "requires": null,
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/nodered",
      "container": "/data",
      "description": "Flows, settings.js and installed nodes",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "1880",
      "container": "1880",
      "protocol": "tcp",
      "description": "Editor and HTTP endpoints",
      "required": true,
      "mask": false,
      "display": "always",
      "default": "1880"
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
}
