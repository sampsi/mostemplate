# Osoite, jossa DNS (portti 53) kuunnellaan. Käytä koneen LAN-osoitetta, jos portti 53 on jo
# käytössä jossain muussa osoitteessa (esim. libvirtin dnsmasq), muuten 0.0.0.0 = kaikki.
DNS_IP=192.168.1.10

# DNS-palvelimen nimi (DNS Server Domain). Klusterissa jokaisella nodella pitää olla eri nimi.
DNS_NIMI=nucserver
