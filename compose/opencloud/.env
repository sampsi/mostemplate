# Osoite jolla OpenCloud avataan selaimessa. Pitää täsmätä tarkalleen, muuten kirjautuminen
# ei toimi (OpenID Connect tarkistaa osoitteen). Vaihda IP tämän koneen osoitteeksi.
OC_URL=https://192.168.1.10:9200

# admin-käyttäjän alkusalasana (käyttäjätunnus: admin). Vaihda ennen ensimmäistä käynnistystä.
ADMIN_SALASANA=vaihda-tama

# true = OpenCloud tarjoaa itse HTTPS:n. false jos edessä on käänteisvälityspalvelin (NPM, Traefik...).
PROXY_TLS=true
